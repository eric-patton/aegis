; Engine configuration file.
; Edit through the Godot editor when practical.
;
; Format:
;   [section]
;   param=value

config_version=5

[application]

config/name="Aegis.Godot"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/resizable=true
window/stretch/mode="disabled"
window/dpi/allow_hidpi=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.0627, 0.0863, 0.102, 1)

[gui]

theme/default_font_hinting=1
theme/default_font_subpixel_positioning=1
theme/default_font_multichannel_signed_distance_field=false
theme/default_font_size=20
fonts/dynamic_fonts/use_oversampling=true
